<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleName</key>
    <string>$(PRODUCT_NAME)</string>
    <key>CFBundleDisplayName</key>
    <string>OPSEC</string>
    <key>CFBundleIdentifier</key>
    <string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
    <key>CFBundleShortVersionString</key>
    <string>$(MARKETING_VERSION)</string>
    <key>CFBundleVersion</key>
    <string>$(CURRENT_PROJECT_VERSION)</string>
    <key>CFBundleExecutable</key>
    <string>$(EXECUTABLE_NAME)</string>
    <key>CFBundlePackageType</key>
    <string>APPL</string>
    <key>LSRequiresIPhoneOS</key>
    <true/>
    <!-- A real launch storyboard is what makes iOS render the app at native
         full-screen resolution. An empty UILaunchScreen dict letterboxes on
         some iOS versions. -->
    <key>UILaunchStoryboardName</key>
    <string>LaunchScreen</string>
    <key>UIApplicationSceneManifest</key>
    <dict>
        <key>UIApplicationSupportsMultipleScenes</key>
        <false/>
    </dict>

    <!-- Camera / mic / photos usage strings -->
    <key>NSCameraUsageDescription</key>
    <string>Used for video calls and sending photos.</string>
    <key>NSMicrophoneUsageDescription</key>
    <string>Used for voice and video calls.</string>
    <key>NSPhotoLibraryUsageDescription</key>
    <string>Used to attach images to messages.</string>
    <key>NSLocationWhenInUseUsageDescription</key>
    <string>Only used when you tap "Share location" to place a pin on the map. Nothing is uploaded automatically.</string>

    <!-- Background modes for VoIP + push -->
    <key>UIBackgroundModes</key>
    <array>
        <string>voip</string>
        <string>remote-notification</string>
        <string>audio</string>
    </array>

    <!-- All traffic is tunnelled through the local Tor SOCKS proxy to a v3
         .onion service. Onion services provide their own end-to-end
         encryption and authentication (the address IS the service key), so
         plain HTTP over Tor is safe. ATS can't match an exception against a
         bare ".onion" host, so we allow arbitrary loads outright — there is
         no clearnet path in this build for it to weaken.
         NOTE: NSAllowsLocalNetworking must NOT appear here — if any of the
         narrower NSAllows* keys is present, iOS IGNORES
         NSAllowsArbitraryLoads entirely (documented ATS behavior). -->
    <key>NSAppTransportSecurity</key>
    <dict>
        <key>NSAllowsArbitraryLoads</key>
        <true/>
    </dict>
</dict>
</plist>
